# ===========================================================================
# Creative Agent — environment (ALL keys optional).
# Absence of a key => that provider runs in MOCK / DISABLED mode. The system
# boots and `make test` passes with this file entirely empty. Copy to `.env`
# and fill only the providers you want to activate. Run the backend from the
# repo root so this file is loaded.
# ===========================================================================

# --- Reasoning lane (strategy, ideation, copy, critic, refine, RFP intake) ---
# The lane is model-agnostic. Two ways to point it at a real model:
#
# A) Anthropic-compatible endpoint (Claude, or GLM/z.ai) — RECOMMENDED for GLM:
#      ANTHROPIC_API_KEY   your key (z.ai key for GLM)
#      ANTHROPIC_BASE_URL  https://api.z.ai/api/anthropic   (unset => Anthropic)
#      CLAUDE_MODEL        generator model id (e.g. glm-4.6 / claude-sonnet-4-5)
#      CRITIC_MODEL        critic model id — MUST differ from CLAUDE_MODEL
#
# B) Any OpenAI-compatible endpoint (GLM, OpenAI, DeepSeek, Together, Ollama…):
#      MODEL_API_KEY       your key            (its presence selects this lane)
#      MODEL_BASE_URL      https://api.z.ai/api/paas/v4/    (default: GLM)
#      GENERATOR_MODEL     generator model id
#      GENERATOR_CRITIC_MODEL   critic model id — MUST differ from the generator
#
# MODEL_PROVIDER forces the choice (anthropic | openai_compatible | mock);
# otherwise it auto-detects from whichever key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-sonnet-4-5
CRITIC_MODEL=claude-opus-4-1
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_BASE_URL=https://api.z.ai/api/paas/v4/
GENERATOR_MODEL=glm-4.6
GENERATOR_CRITIC_MODEL=glm-4.5-air

# --- Conceptial (optional dedicated ideation brain) ------------------------
# Real iff CONCEPTIAL_BASE_URL is set. Unset => the reasoning model ideates.
# Points at a BrainstormLM `creativity_steering/scripts/serve_steering.py`
# instance — the steered-generation harness, run with a 32B ship package
# (STEERING_PACKAGE=creativity_steering/configs/ship_v1_32b.json per
# BrainstormLM's docs/port_to_qwen32b.md), e.g. a local SSH tunnel to a RunPod
# instance: http://localhost:8088. AVOID 8000/8080 for the local tunnel port —
# this app's backend runs on 8080 (see Makefile dev-backend), and 8000 is
# reserved so a Conceptial tunnel there never silently collides with it.
# That harness has no built-in auth; CONCEPTIAL_API_KEY is only sent (as
# Bearer) when set, for callers fronted by an authenticating proxy.
# CONCEPTIAL_VARIANT selects a named steering variant from the package's
# GET /variants (unset => the package's default_variant).
# IDEATOR_FALLBACK labels the ideator brain truthfully when Conceptial is unset
# (set to "glm" on a GLM run so directions aren't mislabelled "claude_high_temp").
CONCEPTIAL_BASE_URL=
CONCEPTIAL_API_KEY=
CONCEPTIAL_VARIANT=
IDEATOR_FALLBACK=claude_high_temp

# --- Search + embeddings (research / divergence) ---------------------------
# search real iff TAVILY_API_KEY set. embeddings "real" iff EMBEDDINGS_BACKEND
# in {auto,minilm,tfidf}; empty/unset/"mock" => mock.
TAVILY_API_KEY=
EMBEDDINGS_BACKEND=auto

# --- Image generation (sketches + moodboards) ------------------------------
# IMAGE_GEN_PROVIDER: fal | replicate | openai | zai | mock  (empty => disabled).
# "zai" (glm-image) reuses ZAI_API_KEY, or MODEL_API_KEY for one-key setups.
IMAGE_GEN_PROVIDER=
IMAGE_GEN_MODEL=flux/schnell
ZAI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# --- Image sourcing (stock lane for hybrid moodboards) ---------------------
# IMAGE_SOURCE_PROVIDER: pexels | unsplash  (empty => generated-only moodboard).
IMAGE_SOURCE_PROVIDER=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Tracing ---------------------------------------------------------------
LANGSMITH_TRACING=
LANGSMITH_API_KEY=

# --- Behavior / tuning knobs -----------------------------------------------
# K = number of creative directions explored. Image counts are generated
# serially (z.ai image tiers rate-limit hard) — keep them modest if using zai.
ASK_CLARIFYING_QUESTIONS=false
K=3
SKETCH_COUNT=3
MOODBOARD_SIZE=6
MOODBOARD_GENERATED_RATIO=0.34
DIVERGENCE_WARN_MIN=0.15
REFINE_ON_FINALIZE=true
