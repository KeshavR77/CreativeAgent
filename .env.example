# ===========================================================================
# AI Creative Agency Platform — environment (ALL keys optional).
# Absence of a key => that provider runs in MOCK / DISABLED mode.
# The system boots and `make test` passes with this file entirely empty.
# Copy to `.env` and fill only the providers you want to activate.
# ===========================================================================

# --- Claude (reasoning: strategy, spec, copy, critic, refine) --------------
# Real iff ANTHROPIC_API_KEY is set. CRITIC_MODEL must differ from CLAUDE_MODEL
# when both resolve real (critic independence — enforced in sub-plan 07).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CRITIC_MODEL=claude-opus-4-1

# --- Conceptial (ideation brain) -------------------------------------------
# Real iff CONCEPTIAL_BASE_URL is set. Unset => IDEATOR_FALLBACK path.
# IDEATOR_FALLBACK: claude_high_temp | mock  (used only when Conceptial unset).
CONCEPTIAL_BASE_URL=
CONCEPTIAL_API_KEY=
IDEATOR_FALLBACK=claude_high_temp

# --- Search + embeddings (divergence / research) ---------------------------
# search real iff TAVILY_API_KEY set.
# embeddings "real" iff EMBEDDINGS_BACKEND in {auto,minilm,tfidf};
#   empty / unset / "mock" => mock. (MiniLM lazy-imported; never at module load.)
TAVILY_API_KEY=
EMBEDDINGS_BACKEND=auto

# --- Image generation lane -------------------------------------------------
# image_gen.enabled iff IMAGE_GEN_PROVIDER set; provider echoes the value.
# IMAGE_GEN_PROVIDER: fal | replicate | openai
# FAL_KEY / REPLICATE_API_TOKEN / OPENAI_API_KEY are the per-provider secrets.
IMAGE_GEN_PROVIDER=
IMAGE_GEN_MODEL=flux/schnell
FAL_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# --- Image sourcing lane ---------------------------------------------------
# image_source.enabled iff IMAGE_SOURCE_PROVIDER set; provider echoes the value.
# IMAGE_SOURCE_PROVIDER: pexels | unsplash
IMAGE_SOURCE_PROVIDER=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Tracing ---------------------------------------------------------------
# tracing iff LANGSMITH_TRACING is truthy (1/true/yes/on).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=

# --- Behavior / tuning knobs (non-provider; defaults suit mock runs) -------
ASK_CLARIFYING_QUESTIONS=false
K=4
SKETCH_COUNT=3
MOODBOARD_SIZE=9
MOODBOARD_GENERATED_RATIO=0.34
DIVERGENCE_WARN_MIN=0.15
REFINE_ON_FINALIZE=true
